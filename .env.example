# Copy this file to ".env" and fill in your real key.
# This .example file is safe to commit to GitHub (it has no real secret).
ANTHROPIC_API_KEY=your-claude-api-key-here

# --- Password reset email (optional; without these the reset link is printed in the server console) ---
FRONTEND_URL=https://ai-resume-reviewer-app.onrender.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
